				</array>
				<key>OutputUUID</key>
				<string>71D91930-BDE3-44C6-BA05-8362577B5068</string>
				<key>UUID</key>
				<string>F0037051-4F31-4736-8882-F60D91013577</string>
				<key>UnlocalizedApplications</key>
				<array>
					<string>Automator</string>
				</array>
				<key>arguments</key>
