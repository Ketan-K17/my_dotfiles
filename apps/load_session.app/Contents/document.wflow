				<key>InputUUID</key>
				<string>7D84A726-60D3-4956-BEC2-D0A7F626B575</string>
				<key>Keywords</key>
				<array>
					<string>Run</string>
				</array>
				<key>OutputUUID</key>
				<string>6EFD3E44-D7E6-416E-B5B1-7251ED95485A</string>
				<key>UUID</key>
				<string>BF24B6F1-E44E-4DAC-A258-7018117D6ED1</string>
				<key>UnlocalizedApplications</key>
				<array>
					<string>Automator</string>
				</array>
				<key>arguments</key>
				<dict>
					<key>0</key>
					<dict>
						<key>default value</key>
						<string>on run {input, parameters}
	
	(* Your script goes here *)
	
	return input
end run</string>
						<key>name</key>
						<string>source</string>
						<key>required</key>
