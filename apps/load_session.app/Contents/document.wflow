<dict>
	<key>AMApplicationBuild</key>
	<string>533</string>
	<key>AMApplicationVersion</key>
	<string>2.10</string>
	<key>AMDocumentVersion</key>
	<string>2</string>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key>
			<dict>
				<key>AMAccepts</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Optional</key>
					<true/>
					<key>Types</key>
					<array>
						<string>com.apple.applescript.object</string>
					</array>
				</dict>
				<key>AMActionVersion</key>
				<string>1.0.2</string>
				<key>AMApplication</key>
				<array>
					<string>Automator</string>
				</array>
				<key>AMParameterProperties</key>
				<dict>
					<key>source</key>
					<dict/>
				</dict>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.applescript.object</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>global fullScreenFailed

on run {input, parameters}
	-- Sessions are plain text: one URL per line, a blank line between windows, # for comments;
	-- lines that are paths (/… or ~/…) are files, opened full screen in their default app
	set folderPath to (POSIX path of (path to home folder)) &amp; "Desktop/sessions/"

	-- Session names, most recently saved first
	set sessionFiles to do shell script "cd " &amp; quoted form of folderPath &amp; " 2&gt;/dev/null &amp;&amp; ls -t -- *.txt 2&gt;/dev/null | sed 's/\\.txt$//' || true"
	if sessionFiles is "" then
		display alert "No sessions saved yet" message "Use save_session to save some tabs first. Sessions live in " &amp; folderPath
		return input
	end if
	set sessionList to paragraphs of sessionFiles

	set chosenSessions to choose from list sessionList with title "Load Session" with prompt "Select sessions to restore (⌘-click for several):" default items {item 1 of sessionList} OK button name "Restore" cancel button name "Cancel" with multiple selections allowed
	if chosenSessions is false then return input

	-- If launching Safari creates a blank window, reuse it for the first window we open
	set blankWindow to missing value
	if application "Safari" is not running then
		tell application "Safari" to activate
		repeat 30 times
			tell application "Safari" to if (count of windows) &gt; 0 then exit repeat
			delay 0.1
		end repeat
		tell application "Safari"
			if (count of windows) is 1 and (count of tabs of window 1) is 1 then
				set u to URL of current tab of window 1
				if u is missing value or u is "" or u is "about:blank" or u starts with "favorites:" then set blankWindow to window 1
			end if
		end tell
	end if

	set tabCount to 0
	set filePaths to {}
	set fullScreenFailed to false
	repeat with sessionName in chosenSessions
		set filePath to folderPath &amp; sessionName &amp; ".txt"
		try
			set fileLines to paragraphs of (read (POSIX file filePath) as «class utf8»)
		on error
			display alert "Couldn't read session \"" &amp; sessionName &amp; "\"" as warning
			set fileLines to {}
		end try

		-- Each blank-line-separated group becomes its own window
		set urls to {}
		repeat with fileLine in (fileLines &amp; {""})
			set l to my trim(contents of fileLine)
			if l is "" then
				if urls is not {} then
					set blankWindow to my openWindow(urls, blankWindow)
					set tabCount to tabCount + (count of urls)
					set urls to {}
				end if
			else if l starts with "/" or l starts with "~/" then
				set end of filePaths to l
			else if l does not start with "#" then
				set end of urls to l
			end if
		end repeat
	end repeat

	set missingFiles to ""
	repeat with p in filePaths
		set p to contents of p
		if p starts with "~/" then set p to (POSIX path of (path to home folder)) &amp; text 3 thru -1 of p
		try
			do shell script "open " &amp; quoted form of p
			try
				my fullScreen(do shell script "f=" &amp; quoted form of p &amp; "; f=${f##*/}; printf %s \"${f%.*}\"")
			on error
				set fullScreenFailed to true
			end try
		on error
			set missingFiles to missingFiles &amp; p &amp; linefeed
		end try
	end repeat
	if missingFiles is not "" then display alert "Couldn't open some files" message missingFiles as warning
	if fullScreenFailed then display alert "Couldn't make some windows full screen" message "Allow load_session under System Settings &gt; Privacy &amp; Security &gt; Accessibility." as warning

	tell application "Safari" to activate
	return input
end run

-- Opens urls as tabs in a new full-screen Safari window (or in reuseWindow); always returns missing value
on openWindow(urls, reuseWindow)
	tell application "Safari"
		if reuseWindow is missing value then
			make new document with properties {URL:item 1 of urls}
			set w to front window
		else
			set w to reuseWindow
			set URL of current tab of w to item 1 of urls
		end if
		repeat with i from 2 to count of urls
			tell w to make new tab at end of tabs with properties {URL:item i of urls}
		end repeat
	end tell
	-- Full screen via the View menu: System Events can't see windows that are on another Space
	try
		tell application "Safari" to activate
		tell application "System Events" to tell menu "View" of menu bar 1 of process "Safari"
			repeat 30 times
				if exists menu item "Enter Full Screen" then
					click menu item "Enter Full Screen"
					exit repeat
				end if
				delay 0.1
			end repeat
			-- Wait for the animation to finish before anything else opens
			repeat 50 times
				if exists menu item "Exit Full Screen" then exit repeat
				delay 0.1
			end repeat
		end tell
		delay 0.5
	on error
		set fullScreenFailed to true
	end try
	return missing value
end openWindow

-- Makes the just-opened file's window full screen: waits for a frontmost window named after it
on fullScreen(stem)
	tell application "System Events"
		repeat 50 times
			set ws to (windows of (first application process whose frontmost is true) whose name contains stem)
			if ws is not {} then
				set value of attribute "AXFullScreen" of item 1 of ws to true
				delay 1
				return
			end if
			delay 0.1
		end repeat
	end tell
	error "No window appeared for " &amp; stem
end fullScreen

on trim(t)
	set ws to {space, tab, return, linefeed}
	repeat while t is not "" and (character 1 of t) is in ws
		if (count of t) is 1 then return ""
		set t to text 2 thru -1 of t
	end repeat
	repeat while t is not "" and (character -1 of t) is in ws
		if (count of t) is 1 then return ""
		set t to text 1 thru -2 of t
	end repeat
	return t
end trim
</string>
				</dict>
				<key>BundleIdentifier</key>
				<string>com.apple.Automator.RunScript</string>
				<key>CFBundleVersion</key>
				<string>1.0.2</string>
